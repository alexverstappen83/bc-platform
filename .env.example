# bc-platform configuratie — kopieer naar .env en pas aan.
# .env staat in .gitignore; .env.example bevat GEEN secrets en wordt wel gecommit.

# --- VM-provider ---
# multipass = één commando, NAT, werkt over wifi (aanrader zonder kabel).
# utm       = grafische VM in UTM (voor bridged/geavanceerd, kabel).
VM_PROVIDER=multipass

# --- Netwerkmodus ---
# nat     = VM achter UTM Shared Network (werkt over wifi, geen kabel nodig).
#           Diensten zijn bereikbaar vanaf DEZE Mac op het VM-IP.
# bridged = VM krijgt een eigen LAN-IP (kabel nodig); diensten LAN-breed
#           bereikbaar via MetalLB. Zet dit pas als je bekabeld ethernet hebt.
NETWORK_MODE=nat

# --- Netwerk ---
HOST_IP=192.168.124.50          # de Mac zelf
# VM_IP:
#   bridged -> statisch IP dat de VM krijgt (bijv. 192.168.124.51)
#   nat     -> het IP dat de VM van UTM krijgt; lees het na de boot af in het
#              UTM-venster (of met `ip -4 addr show` in de VM) en vul het hier in.
VM_IP=192.168.124.51
LAN_GATEWAY=192.168.124.1       # je router — verifieer dit (alleen bridged)
VM_NIC=enp0s1                   # NIC-naam IN de VM (verifieer met: ip a)
SSH_USER=ubuntu

# --- MetalLB pool (moet buiten je DHCP-range vallen) ---
METALLB_RANGE=192.168.124.60-192.168.124.70

# --- Vaste VIP's (gepind via MetalLB-annotatie) ---
TRAEFIK_IP=192.168.124.60
TECHNITIUM_IP=192.168.124.61
PORTAINER_IP=192.168.124.62

# --- Domein (interne zone in Technitium) ---
DOMAIN=home.brightcubes.nl

# --- Wachtwoorden — VERANDER DEZE in je .env ---
TECHNITIUM_ADMIN_PASSWORD=changeme
PORTAINER_ADMIN_PASSWORD=changeme
