# VOORBEELD — bevat GEEN echte waarden en wordt wel gecommit.
# Maak het echte Secret out-of-band aan (zie README.md), nooit met echte waarden
# in Git. Het Secret heet 'bc-doelen-secrets' per namespace.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://bcdoelen:<zelfde-als-POSTGRES_PASSWORD>@db:5432/bcdoelen
JWT_SECRET=
SECRET_ENCRYPTION_KEY=
INITIAL_ADMIN_PASSWORD=
GITHUB_TOKEN=
